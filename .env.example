# ============================================================
# RAG 问答系统 — 环境变量配置
# ============================================================
# 使用方法：复制本文件为 .env，然后填入你的真实 Key
#   cp .env.example .env
# ============================================================

# ---------- LLM 大模型（生成回答用）----------
# 主力：DeepSeek API（便宜、中文好、OpenAI 兼容格式）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 备选：OpenAI API（如果 DeepSeek 挂了临时切过来）
OPENAI_API_KEY=sk-your-openai-api-key-here

# 当前使用哪个 LLM：deepseek 或 openai
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ---------- Embedding 模型（文本转向量）----------
# 默认使用本地 Qwen3-Embedding-0.6B，免费、无需 API Key、中文 SOTA
# 备选：OpenAI text-embedding-3-small（需要 OPENAI_API_KEY）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ---------- 路径配置 ----------
CHROMA_PERSIST_DIR=./chroma_data
DOCS_DIR=./docs
